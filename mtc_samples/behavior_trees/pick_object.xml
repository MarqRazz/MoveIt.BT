<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Pick_Object">
      <Sequence name="Pick Object">
        <!-- Add example scene to the robots planning_scene -->
        <LoadPlanningSceneFromFile package_name="mtc_samples"
                                   subdirectory_name="config"
                                   file_name="mtc_pnp_example.scene"/>
        <MTCCartesianPlanner planner="{cartesian_planner}"/>
        <MTCPipelinePlanner planner="{pipeline_planner}"/>
        <Sequence name="Create MTC Task">
          <Sequence name="Pick Object Task">
            <MTCInitializeTask task_name="pick object"
                              task="{mtc_task}"/>
            <MTCCurrentStateStage stage_name="current state"
                                  task="{mtc_task}"/>
            <MTCMoveToStage stage_name="open hand"
                            planner="{pipeline_planner}"
                            group_name="right_gripper"
                            goal_name="open"
                            task="{mtc_task}"/>
            <MTCConnectStage stage_name="move to pick"
                             group_name="right_manipulator"
                             mtc_planner="{pipeline_planner}"
                             task="{mtc_task}"/>
            <CreateVector3Stamped frame_id="right_arm_base_link"
                                  pose="1,0,0"
                                  pose_stamped_msg = "{approach_grasp}"/>
            <MTCMoveRelativeStage stage_name="approach object"
                                  planner="{cartesian_planner}"
                                  group_name="right_manipulator"
                                  ik_frame="right_arm_grasp_link"
                                  min_distance="0.02"
                                  max_distance="0.05"
                                  direction_vector="{approach_grasp}"
                                  task="{mtc_task}"/>
            <CreatePoseStamped frame_id="right_arm_base_link"
                               pose="0.5,0,0,3.14,0,0"
                               pose_stamped_msg = "{grasp_pose}"/>
            <MTCGenerateGraspPose seed_pose="{grasp_pose}"
                                  pose_dimension="YAW"
                                  sampling_width="1.57"
                                  monitored_stage_name="open hand"
                                  task="{mtc_task}"/>
            <MTCGraspObject object_name="object"
                            hand_group_name="right_gripper"
                            hand_grasp_frame="right_arm_grasp_link"
                            planner="{pipeline_planner}"
                            task="{mtc_task}"/>
            <CreateVector3Stamped frame_id="right_arm_base_link"
                                  pose="0,0,1"
                                  pose_stamped_msg = "{lift_grasp}"/>
            <MTCMoveRelativeStage stage_name="lift object"
                                  planner="{cartesian_planner}"
                                  group_name="right_manipulator"
                                  ik_frame="right_arm_grasp_link"
                                  min_distance="0.02"
                                  max_distance="0.05"
                                  direction_vector="{lift_grasp}"
                                  task="{mtc_task}"/>
          </Sequence>
          <Sequence name="Place Object Task">
            <MTCConnectStage stage_name="move to place"
                             group_name="right_manipulator"
                             mtc_planner="{pipeline_planner}"
                             task="{mtc_task}"/>
            <CreateVector3Stamped frame_id="right_arm_base_link"
                                  pose="0,0,-1"
                                  pose_stamped_msg = "{approach_place}"/>
            <MTCMoveRelativeStage stage_name="approach place pose"
                                  planner="{cartesian_planner}"
                                  group_name="right_manipulator"
                                  ik_frame="right_arm_grasp_link"
                                  min_distance="0.02"
                                  max_distance="0.05"
                                  direction_vector="{approach_place}"
                                  task="{mtc_task}"/>
            <CreatePoseStamped frame_id="platform_link"
                               pose="0,0,0.2,3.14,0,1.57"
                               pose_stamped_msg = "{place_pose}"/>
            <MTCSampleGraspPose seed_pose="{place_pose}"
                                pose_dimension="YAW"
                                sampling_width="1.57"
                                monitored_stage_name="lift object"
                                task="{mtc_task}"/>
            <MTCReleaseObject object_name="object"
                              hand_group_name="right_gripper"
                              hand_grasp_frame="right_arm_grasp_link"
                              planner="{pipeline_planner}"
                              task="{mtc_task}"/>
            <MTCMoveToStage stage_name="move home"
                            planner="{pipeline_planner}"
                            group_name="right_manipulator"
                            goal_name="right_arm_home"
                            task="{mtc_task}"/>
          </Sequence>
        </Sequence>
        <MTCPlanTask task="{mtc_task}"
                     max_solutions="1"/>
        <MTCExecuteTask task="{mtc_task}"/>
      </Sequence>
  </BehaviorTree>
</root>
