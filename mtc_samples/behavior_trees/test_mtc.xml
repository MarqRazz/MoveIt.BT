<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="TestMtc">
    <Sequence name="Test Task :)">
      <!-- Add example scene to the robots planning_scene -->
      <LoadPlanningSceneFromFile package_name="mtc_samples"
                                 subdirectory_name="config"
                                 file_name="mtc_pnp_example.scene"/>
      <!-- Create free space and cartesian planners -->
      <MTCCartesianPlanner planner="{cartesian_planner}"/>
      <MTCPipelinePlanner planner="{pipeline_planner}"/>
      <!-- ask the arm to move up -->
      <Sequence name="Move Up">
        <MTCInitializeTask task_name="Move up"
                           task="{mtc_task}"/>
        <MTCCurrentStateStage task="{mtc_task}"/>
        <MTCMoveRelativeStage task="{mtc_task}"
                              planner="{cartesian_planner}"
                              group_name="panda_arm"
                              ik_frame="panda_link8"
                              min_distance="0.1"
                              max_distance="0.2"/>
        <MTCPlanTask task="{mtc_task}"
                     max_solutions="1"/>
        <MTCExecuteTask task="{mtc_task}"/>
      </Sequence>
      <!-- ask the arm to move up as much as it can and then back to the ready pose -->
      <Sequence name="Move up more and back to Ready">
        <MTCInitializeTask task_name="Move up more and back to ready"
                           task="{mtc_task}"/>
        <MTCCurrentStateStage task="{mtc_task}"/>
        <MTCMoveRelativeStage task="{mtc_task}"
                              planner="{cartesian_planner}"
                              group_name="panda_arm"
                              ik_frame="panda_link8"
                              min_distance="0.01"
                              max_distance="0.2"/>
        <MTCMoveToStage task="{mtc_task}"
                        planner="{pipeline_planner}"
                        group_name="panda_arm"
                        goal_name="ready"
                        stage_name="Move to ready"/>
        <MTCPlanTask task="{mtc_task}"
                     max_solutions="1"/>
        <MTCExecuteTask task="{mtc_task}"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>
</root>
